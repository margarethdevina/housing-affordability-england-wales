>     "House-price growth, 2015-2024 (%)"

. 
. label variable earnings_growth_2024 ///
>     "Earnings growth, 2015-2024 (%)"

. 
. label variable growth_gap_2024 ///
>     "House-price growth minus earnings growth, 2015-2024"

. 
