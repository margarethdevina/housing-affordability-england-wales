>     if !missing(affordability_2015, affordability_2024)
(209 missing values generated)

. 
. 
. gen affordability_pct_change_2024 = ///
>     100 * ((affordability_2024 / affordability_2015) - 1) ///
>     if !missing(affordability_2015, affordability_2024)
(209 missing values generated)

